# Port the Express API listens on
PORT=5000

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
# Replace <username>, <password> and the cluster address with your own.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/feedwise?retryWrites=true&w=majority

# Frontend URL(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173
